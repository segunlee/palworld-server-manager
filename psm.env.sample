# Palworld Server Manager — web deployment settings (SAMPLE).
#
# Copy this to psm.env and fill in a real secret:
#     cp psm.env.sample psm.env
#     node scripts/psm-setup.js --init      # generates PSM_AUTH_SECRET for you
#
# psm.env is loaded by systemd (EnvironmentFile=) and the setup scripts. It holds
# the session signing secret, so it is gitignored — never commit the real file.
# Keep it readable only by this user:  chmod 600 psm.env

# HMAC key for session cookies (>= 32 hex chars). Rotating it logs everyone out.
# Generate one with:  openssl rand -hex 32     (or `psm-setup.js --init`)
PSM_AUTH_SECRET=replace-with-a-random-32-byte-hex-string

# Listen address. 127.0.0.1 keeps the UI on loopback (use a reverse proxy in front);
# 0.0.0.0 exposes it on the LAN — only do that on a trusted network.
HOSTNAME=127.0.0.1
PORT=4317

# Registry DB, logs, backups and staging live here.
PALWORLD_MANAGER_DATA_DIR=/home/pwserver/.psm-data

# Set to 1 when HTTPS terminates in front of the app (marks the cookie Secure).
PSM_COOKIE_SECURE=0

NODE_ENV=production
